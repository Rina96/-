# Julia AI - Multi-CRM Platform Production Configuration

# ============================================
# APPLICATION
# ============================================
APP_NAME=Julia AI - Multi-CRM Platform
DEBUG=False
PORT=8000

# ============================================
# DATABASE (PostgreSQL for production)
# ============================================
# For production, use PostgreSQL instead of SQLite
# DATABASE_URL=sqlite+aiosqlite:///./ai_sales.db
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/julia_ai

# ============================================
# AI ENGINES
# ============================================
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
VOICE_ENABLED=True
WHISPER_ENABLED=True
VISION_ENABLED=True

# ============================================
# GREEN API (WhatsApp)
# ============================================
GREEN_API_ID_INSTANCE=your-instance-id
GREEN_API_API_TOKEN_INSTANCE=your-api-token
GREEN_API_HOST=https://api.green-api.com

# ============================================
# DEFAULT CRM (AlfaCRM - for backward compatibility)
# ============================================
# This is used as the default company if none exists
ALFA_SUBDOMAIN=your-subdomain
ALFA_EMAIL=your-email@example.com
ALFA_API_KEY=your-api-key
ALFA_APP_KEY=your-app-key
ALFA_BASE_URL=https://your-subdomain.s20.online

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO
LOG_FILE=/var/log/julia/julia.log

# ============================================
# PRODUCTION SETTINGS
# ============================================
WORKERS=4
WORKER_CLASS=uvicorn.workers.UvicornWorker
MAX_REQUESTS=1000
MAX_REQUESTS_JITTER=100

# ============================================
# OPTIONAL: Sentry (Error tracking)
# ============================================
SENTRY_DSN=

# ============================================
# OPTIONAL: Redis (For caching/sessions)
# ============================================
REDIS_URL=redis://localhost:6379/0
